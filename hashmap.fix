module HashMap;

import Hash::{HashKey, Hash::hash};
import Std::{
    loop, Array, Bool, I64, Iterator, Option, U64, Add::add,
    Array::{fill, set, @, @size}, I64::bit_and, ToI64::i64,
    Iterator::{flat_map, fold, map, range, Item}, LoopState::{break, continue},
    Option::{as_some, as_some_or, is_none, none, some, to_iter}, Tuple2::{@0, @1}
};

// A hash table, holding a value under each key.
//
// The entries lie directly in one array, a free slot holding `none`. An entry whose slot is taken
// goes into the next free slot after it, and a lookup starts at the slot the hash names and walks
// forward until it meets the entry or a free slot. A third of the slots are kept free for those
// walks to end at.
//
// An entry carries the hash of its key beside the key, so a lookup rules a slot out by comparing
// two 64-bit words, and both a deletion and a rehash find the slot an entry belongs in without
// hashing its key again.
type HashMap k v = unbox struct { _slots : Array (Option ((U64, k), v)), _size : I64 };

// The number of elements a table of a number of slots holds before it grows.
//
// A walk ends at a free slot, and the walks lengthen as the table fills, so the table grows while a
// third of its slots are still free.
//
// # Parameters
// - `slot_count` : Number of slots the table has.
_capacity_of : I64 -> I64;
_capacity_of = |slot_count| slot_count - slot_count / 3;

// Empties the slot at an index, and closes the walk that slot interrupted: the first entry after it
// whose own walk passes through it moves into it, and the slot that entry leaves is emptied in turn.
//
// # Parameters
// - `slot_idx` : Index of the slot to empty.
// - `slots` : Slots to erase from.
_erase_slot : I64 -> Array (Option ((U64, k), v)) -> Array (Option ((U64, k), v));
_erase_slot = |slot_idx, slots| (
    let mask = slots.@size - 1;
    loop((slots, slot_idx, (slot_idx + 1).bit_and(mask)), |(slots, hole, i)| (
        let slot = slots.@(i);
        if slot.is_none { break $ slots.set(hole, Option::none()) };
        let entry = slot.as_some;
        let home = entry.@0.@0.i64.bit_and(mask);
        // The entry stays where it is when the walk from its home slot starts after the hole, since
        // that walk then never passes through the hole.
        if (i - home).bit_and(mask) < (i - hole).bit_and(mask) {
            continue $ (slots, hole, (i + 1).bit_and(mask))
        };
        continue $ (slots.set(hole, Option::some(entry)), i, (i + 1).bit_and(mask))
    ))
);

// Finds the free slot an entry goes into, in a table holding no entry with its key.
//
// # Parameters
// - `h` : Hash of the key.
// - `slots` : Slots to search in.
_find_free_slot : U64 -> Array (Option ((U64, k), v)) -> I64;
_find_free_slot = |h, slots| (
    let mask = slots.@size - 1;
    loop(h.i64.bit_and(mask), |i| (
        if slots.@(i).is_none { break $ i };
        continue $ (i + 1).bit_and(mask)
    ))
);

// Finds the slot a key belongs in.
// Returns pair of (index of the slot, whether the key is in it).
//
// # Parameters
// - `h` : Hash of the key.
// - `k` : Key to search for.
// - `slots` : Slots to search in.
_find_slot : [k : HashKey] U64 -> k -> Array (Option ((U64, k), v)) -> (I64, Bool);
_find_slot = |h, k, slots| (
    let mask = slots.@size - 1;
    loop(h.i64.bit_and(mask), |i| (
        let slot = slots.@(i);
        if slot.is_none { break $ (i, false) };
        if slot.as_some.@0 == (h, k) { break $ (i, true) };
        continue $ (i + 1).bit_and(mask)
    ))
);

// Puts an entry into a HashMap holding no entry with its key, which is what lets it take the first
// free slot of its walk without comparing any key.
//
// # Parameters
// - `entry` : Entry to place.
// - `mp` : HashMap to place the entry into.
_place : ((U64, k), v) -> HashMap k v -> HashMap k v;
_place = |entry, mp| (
    let slot_idx = mp.@_slots._find_free_slot(entry.@0.@0);
    mp.mod__slots(Array::set(slot_idx, Option::some(entry))).mod__size(Add::add(1))
);

// The number of slots a table needs to hold a number of elements. It is a power of two, so that
// the slot a hash names is its low bits.
//
// # Parameters
// - `max_size` : Number of elements the table is to hold.
_slots_for : I64 -> I64;
_slots_for = |max_size| (
    loop(4, |slot_count|
        if HashMap::_capacity_of(slot_count) >= max_size { break $ slot_count }
        else { continue $ slot_count * 2 }
    )
);

// Converts a HashMap into an iterator over its entries.
//
// # Parameters
// - `mp` : HashMap to convert to an iterator.
_to_iter_entries : [?it : Iterator, Item ?it = ((U64, k), v)] HashMap k v -> ?it;
_to_iter_entries = |mp| (
    Iterator::range(0, mp.@_slots.@size).flat_map(|slot_idx| mp.@_slots.@(slot_idx).to_iter)
);

// Checks whether a hashmap contains a key.
//
// # Parameters
// - `k` : Key to search for.
// - `mp` : HashMap to search in.
contains_key : [k : HashKey] k -> HashMap k v -> Bool;
contains_key = |k, mp| mp.@_slots._find_slot(k.hash, k).@1;

// Creates an empty HashMap which is reserved so that it will not rehash until size exceeds the spacified value.
//
// # Parameters
// - `capacity` : Initial capacity of the HashMap.
empty : I64 -> HashMap k v;
empty = |max_size| (
    HashMap { _slots : Array::fill(HashMap::_slots_for(max_size), Option::none()), _size : 0 }
);

// Erases an element from a HashMap.
//
// # Parameters
// - `k` : Key of the element to erase.
// - `mp` : HashMap to erase from.
erase : [k : HashKey] k -> HashMap k v -> HashMap k v;
erase = |k, mp| (
    let (slot_idx, found) = mp.@_slots._find_slot(k.hash, k);
    if found {
        mp.mod__slots(HashMap::_erase_slot(slot_idx)).mod__size(Add::add(-1))
    } else { mp }
);

// Finds an element from a HashMap.
//
// # Parameters
// - `k` : Key to search for.
// - `mp` : HashMap to search in.
find : [k : HashKey] k -> HashMap k v -> Option v;
find = |k, mp| (
    let (slot_idx, found) = mp.@_slots._find_slot(k.hash, k);
    if found {
        Option::some(mp.@_slots.@(slot_idx).as_some.@1)
    } else { Option::none() }
);

// Finds an element from a HashMap. If the map doesn't contain the key, it returns the given default value.
//
// # Parameters
// - `k` : Key to search for.
// - `def` : Default value to return if the key is not found.
// - `mp` : HashMap to search in.
find_or : [k : HashKey] k -> v -> HashMap k v -> v;
find_or = |key, def, mp| mp.find(key).as_some_or(def);

// Gets capacity of a HashMap: the number of elements it holds before it grows.
//
// # Parameters
// - `mp` : HashMap to get capacity of.
@capacity : HashMap k v -> I64;
@capacity = |mp| HashMap::_capacity_of(mp.@_slots.@size);

// Gets size (number of elements) of a HashMap.
//
// # Parameters
// - `mp` : HashMap to get size of.
@size : HashMap k v -> I64;
@size = |mp| mp.@_size;

// (Deprecated) Renamed `HashMap::get_capacity` to `HashMap::@capacity` for brevity.
//
// The old name `HashMap::get_capacity` is now deprecated but will remain available
// for the foreseeable future to maintain backward compatibility.
//
// Gets capacity of a HashMap.
//
// # Parameters
// - `mp` : HashMap to get capacity of.
get_capacity : HashMap k v -> I64;
get_capacity = @capacity;

// (Deprecated) Renamed `HashMap::get_size` to `HashMap::@size` for brevity.
// The old name `HashMap::get_size` is now deprecated but will remain available
// for the foreseeable future to maintain backward compatibility.
//
// Gets size (number of elements) of a HashMap.
//
// # Parameters
// - `mp` : HashMap to get size of.
get_size : HashMap k v -> I64;
get_size = @size;

// Inserts an element into a HashMap.
//
// # Parameters
// - `k` : Key of the element to insert.
// - `v` : Value of the element to insert.
// - `mp` : HashMap to insert into.
insert : [k : HashKey] k -> v -> HashMap k v -> HashMap k v;
insert = |k, v, mp| (
    let mp = if mp.@_size < mp.@capacity { mp } else { mp.reserve(mp.@_size + 1) };
    let h = k.hash;
    let (slot_idx, found) = mp.@_slots._find_slot(h, k);
    let mp = mp.mod__slots(Array::set(slot_idx, Option::some(((h, k), v))));
    if found { mp } else { mp.mod__size(Add::add(1)) }
);

// Reserves a HashMap so that it will not rehash until size exceeds the spacified value.
//
// # Parameters
// - `capacity` : Capacity to reserve.
// - `mp` : HashMap to reserve.
reserve : I64 -> HashMap k v -> HashMap k v;
reserve = |max_size, mp| (
    if max_size <= mp.@capacity { mp };
    mp._to_iter_entries.fold(HashMap::empty(max_size), |entry, new_mp| new_mp._place(entry))
);

// Converts a HashMap into an iterator.
//
// # Parameters
// - `mp` : HashMap to convert to an iterator.
to_iter : [?it : Iterator, Item ?it = (k, v)] HashMap k v -> ?it;
to_iter = |mp| mp._to_iter_entries.map(|((_, k), v)| (k, v));
